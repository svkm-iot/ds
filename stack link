# include <stdio.h>
# include <stdlib.h>

struct Node {
    int data;
    struct Node* next;
};

struct Node *top = NULL;

void push(int x) {
    struct Node *newNode = (struct Node*)malloc(sizeof(struct Node));
    newNode -> data = x;
    newNode -> next = top;
    top = newNode;
    printf("%d pushed .\n",x);

}
void pop() {
    if(top == NULL) {
        printf("stack is empty ! ");
      
    }  else {
        struct Node *temp = top;
        printf("%d popped .\n", temp ->data);
        top = top -> next ;
        free(temp);
    }
}

void display () {
    if (top == NULL) {
        printf("stack is empty !\n") ;
     } else {
        struct Node *temp = top ;
        printf("stack :\n");
        while(temp != NULL){
            printf("%d", temp -> data);
            temp = temp -> next;
        }
        printf("\n");
    }
}

int main () {
    int choice , value ;
    while(1) {
        printf("\n---stack menu---\n1.push \n2. pop \n3.display \n4. exit\n");
        printf("Enter choice :");
        scanf("%d" ,&choice);
        switch(choice) {
          case 1 : 
          printf("Enter value to push :\n");
          scanf("%d", &value);
          push(value);
          break;
          
           case 2 :
           pop();
           break;

           case 3 :
           display();
           break;

           case 4 :
           return 0 ;

           default :
           printf("invalid choice !");

        }
    }
    
}
